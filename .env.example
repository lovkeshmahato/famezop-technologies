# --- Database (Prisma + PostgreSQL) ---
# Local: docker run --name famezop-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/famezop?schema=public"

# --- Email (Resend) ---
# https://resend.com/api-keys — without this set, emails are logged to the
# console instead of sent, so local dev works with no account.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Famezop Technologies <notifications@famezop.com>"
RESEND_NOTIFY_EMAIL="hello@famezop.com"

# --- Sanity CMS ---
# https://www.sanity.io/manage — create a project, then run `npx sanity init`
# or set these manually and visit /studio to start adding content.
# Without these set, the site renders on realistic fallback content from
# lib/content/*.ts instead of failing.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
# Shared secret checked by app/api/revalidate/route.ts (see README) for
# Sanity's on-demand revalidation webhook.
SANITY_REVALIDATE_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://www.famezop.com"

# --- Analytics / Search Console ---
NEXT_PUBLIC_GA_ID=""
GOOGLE_SITE_VERIFICATION=""
