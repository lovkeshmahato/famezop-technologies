# --- Database (Prisma + Supabase Postgres) ---
# Project: "Famezop Technologies" org, project ref bltrzsdjknsbfqbcojdv
# (ap-northeast-1). Get the real values (with your DB password) from:
# Supabase Dashboard -> this project -> Connect button.
# DATABASE_URL = Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.bltrzsdjknsbfqbcojdv:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = Session pooler (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.bltrzsdjknsbfqbcojdv:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Email (Resend) ---
# Account connected, domain famezoptechnologies.com is added and verified
# in Resend, "Famezop Website" sending-access key already created. Get the
# key's value from resend.com/api-keys (shown once at creation — if lost,
# revoke and create a new one). Without this set, emails are logged to the
# console instead of sent, so local dev works with no key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Famezop Technologies <notifications@famezoptechnologies.com>"
RESEND_NOTIFY_EMAIL="hello@famezoptechnologies.com"

# --- Sanity CMS ---
# Project ID isn't a secret — this is the real Famezop Sanity project.
# Visit /studio on your running site to add content (no separate deploy
# needed). Without a project ID set, the site renders on realistic fallback
# content from lib/content/*.ts instead of failing.
NEXT_PUBLIC_SANITY_PROJECT_ID="roe3ezhc"
NEXT_PUBLIC_SANITY_DATASET="production"
# Needed for Studio writes and draft/preview content. Create one at
# sanity.io/manage -> this project -> API -> Tokens (Editor permission).
# This one IS a secret — set it directly in your host's env vars, not here.
SANITY_API_TOKEN=""
# Shared secret checked by app/api/revalidate/route.ts (see README) for
# Sanity's on-demand revalidation webhook. Also a secret.
SANITY_REVALIDATE_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://famezoptechnologies.com"

# --- Analytics / Search Console ---
NEXT_PUBLIC_GA_ID=""
GOOGLE_SITE_VERIFICATION=""
